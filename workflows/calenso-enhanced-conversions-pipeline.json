      "id": "9ab70a20-af67-47aa-a0f4-34e2d519fa3f",
      "name": "Route Valid Conversion"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\n// EMAIL NORMALIZATION\nlet normalizedEmail = null;\n\nif (data.email) {\n  normalizedEmail = String(data.email)\n    .trim()\n    .toLowerCase();\n\n  // Google requires dots before @ to be removed for Gmail / Googlemail\n  const [localPart, domain] = normalizedEmail.split('@');\n\n  if (\n    localPart &&\n    domain &&\n    (domain === 'gmail.com' || domain === 'googlemail.com')\n  ) {\n    normalizedEmail = `${localPart.replace(/\\./g, '')}@${domain}`;\n  }\n}\n\n// PHONE NORMALIZATION\nlet normalizedPhone = null;\n\nif (data.phone) {\n  let phone = String(data.phone).trim();\n\n  // Keep the leading +, remove spaces, brackets, dashes, etc.\n  phone = phone.replace(/[^\\d+]/g, '');\n\n  // Basic E.164 validation\n  if (/^\\+[1-9]\\d{10,14}$/.test(phone)) {\n    normalizedPhone = phone;\n  }\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      normalized_email: normalizedEmail,\n      normalized_phone: normalizedPhone,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
