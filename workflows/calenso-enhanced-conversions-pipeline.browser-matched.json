      "id": "8f95997c-0000-4000-8000-fd93e42c611c",
      "name": "Route Matched Enhancement"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\n// EMAIL NORMALIZATION\nlet normalizedEmail = null;\n\nif (data.email) {\n  normalizedEmail = String(data.email)\n    .trim()\n    .toLowerCase();\n\n  // Google requires dots before @ to be removed for Gmail / Googlemail\n  const [localPart, domain] = normalizedEmail.split('@');\n\n  if (\n    localPart &&\n    domain &&\n    (domain === 'gmail.com' || domain === 'googlemail.com')\n  ) {\n    normalizedEmail = localPart.replace(/\\./g, '') + '@' + domain;\n  }\n}\n\n// PHONE NORMALIZATION\nfunction normalizePhone(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n\n  const rawPhone = String(value).trim();\n\n  if (rawPhone === '' || /[A-Za-z]/.test(rawPhone)) {\n    return null;\n  }\n\n  const compactPhone = rawPhone.replace(/[\\s\\-()./]/g, '');\n\n  if ((compactPhone.match(/\\+/g) || []).length > 1) {\n    return null;\n  }\n\n  let normalizedPhone = null;\n\n  if (compactPhone.startsWith('+')) {\n    normalizedPhone = compactPhone;\n  } else if (compactPhone.startsWith('00')) {\n    normalizedPhone = '+' + compactPhone.slice(2);\n  } else if (compactPhone.startsWith('0')) {\n    normalizedPhone = '+49' + compactPhone.slice(1);\n  } else {\n    return null;\n  }\n\n  if (/^\\+[1-9]\\d{7,14}$/.test(normalizedPhone)) {\n    return normalizedPhone;\n  }\n\n  return null;\n}\n\nconst normalizedPhone = normalizePhone(data.phone);\n\nreturn [\n  {\n    json: {\n      ...data,\n      normalized_email: normalizedEmail,\n      normalized_phone: normalizedPhone,\n    },\n  },\n];"
      },
