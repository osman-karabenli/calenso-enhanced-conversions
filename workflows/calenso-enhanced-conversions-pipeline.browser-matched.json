    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst missingFields = [];\nconst invalidFields = [];\n\nif (!data.event_type) {\n  missingFields.push('event_type');\n} else if (data.event_type !== 'appointment.booking.created') {\n  invalidFields.push('event_type');\n}\n\nif (!data.appointment_uuid) {\n  missingFields.push('appointment_uuid');\n}\n\nif (!data.appointment_start_utc) {\n  missingFields.push('appointment_start_utc');\n}\n\nif (!data.customer_uuid) {\n  missingFields.push('customer_uuid');\n}\n\nif (!data.email) {\n  missingFields.push('email');\n} else {\n  const email = String(data.email).trim();\n\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\n  if (!emailRegex.test(email)) {\n    invalidFields.push('email');\n  }\n}\n\nif (data.phone !== null && data.phone !== undefined) {\n  const phone = String(data.phone).trim();\n\n  if (phone === '') {\n    invalidFields.push('phone');\n  }\n}\n\nconst validationStatus =\n  missingFields.length === 0 && invalidFields.length === 0\n    ? 'OK'\n    : 'REVIEW_REQUIRED';\n\nreturn [\n  {\n    json: {\n      ...data,\n      validation_status: validationStatus,\n      missing_fields: missingFields,\n      invalid_fields: invalidFields,\n    },\n  },\n];"
      },
